# ── API routing ────────────────────────────────────────────────────────────────
#
# GATEWAY MODE (full three-layer enforcement):
#   Set NEXT_PUBLIC_API_URL when ALL Python services are running and wired.
#   demo-auth.ts will exchange a JWT on login and api.ts will send it as Bearer.
#
# BFF MODE (default for local demo):
#   NEXT_PUBLIC_API_URL is empty; routes at /api/v1/... use in-process demo state.
#
# Phase 4B Step 1 — AUTH only mode:
#   NEXT_PUBLIC_AUTH_URL points to the real gateway for JWT exchange only.
#
# Phase 4B Step 2 — GATEWAY MODE (active):
#   NEXT_PUBLIC_API_URL set → inventory + products pages read from real backend.
#   NEXT_PUBLIC_AUTH_URL kept for auth JWT exchange (port 8000 has auth service).
#   Note: port 8009 is used for the gateway with correct INVENTORY_SERVICE_URL.
#

# ── GATEWAY MODE (Real Backend with Local PostgreSQL) ───────────────────────
# Set NEXT_PUBLIC_USE_MOCK_DATA=false to use real backend API
# Backend services will read from local PostgreSQL database (smart_dev)
NEXT_PUBLIC_USE_MOCK_DATA=false

# Real gateway for JWT exchange (auth service wired — Phase 4B Step 1)
NEXT_PUBLIC_AUTH_URL=http://localhost:8000

# Real gateway for inventory + products API calls (Phase 4B Step 2)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default locale for the frontend
NEXT_PUBLIC_DEFAULT_LOCALE=en
